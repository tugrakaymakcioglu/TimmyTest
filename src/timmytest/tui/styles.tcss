/* TimmyTest terminal application - retro arcade palette on a deep slate ground. */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

Button {
    margin: 0 1;
    min-width: 12;
}

Input {
    background: #161b22;
    border: tall #30363d;
    color: #f3e2b8;
}

Input:focus {
    border: tall #2f9fa8;
}

Checkbox {
    background: transparent;
    border: none;
    height: 1;
    padding: 0;
}

Checkbox:focus {
    background: #161b22;
}

/* ---------------------------------------------------------------- splash */

#splash-root {
    height: 100%;
    layout: vertical;
    padding: 1 2;
}

#splash-hero {
    height: 1fr;
}

#splash-footer {
    height: 5;
    padding: 0 6;
    layout: vertical;
}

#splash-status-row {
    height: 1;
}

#splash-status {
    width: 1fr;
    height: 1;
}

#splash-percent {
    width: 6;
    height: 1;
    text-align: right;
}

#splash-bar {
    height: 1;
    width: 100%;
}

#splash-version {
    height: 1;
    text-align: center;
    padding-top: 1;
}

/* ----------------------------------------------------------------- setup */

#setup-root {
    height: 100%;
    layout: vertical;
    padding: 2 4;
}

#setup-title {
    height: 3;
    text-align: center;
}

#setup-columns {
    height: 1fr;
}

.check-panel {
    width: 1fr;
    height: 100%;
    border: round #30363d;
    padding: 1 2;
    margin: 0 1;
}

#setup-bar {
    height: 1;
    width: 100%;
    margin: 1 1;
}

#setup-summary {
    height: 2;
    text-align: center;
}

#setup-buttons {
    height: 3;
    align: center middle;
}

/* -------------------------------------------------------------- language */

#lang-root {
    height: 100%;
    layout: vertical;
    align: center middle;
    padding: 2 4;
}

#lang-title {
    height: 4;
    width: 100%;
    text-align: center;
}

#lang-cards {
    height: 11;
    width: auto;
    align: center middle;
}

.lang-card {
    width: 36;
    height: 9;
    border: round #30363d;
    padding: 1 2;
    margin: 0 2;
    background: #0d1117;
}

.lang-card.selected {
    border: heavy #f3e2b8;
    background: #161b22;
}

#lang-hint {
    height: 3;
    width: 100%;
    text-align: center;
    padding-top: 2;
}

/* ------------------------------------------------- finalize / preparing */

#final-root,
#prep-root {
    height: 100%;
    layout: vertical;
    align: center middle;
    padding: 2 4;
}

#final-title,
#prep-title {
    height: 4;
    width: 100%;
    text-align: center;
}

#final-steps,
#prep-steps {
    height: auto;
    width: auto;
}

#final-bar,
#prep-bar {
    width: 64;
    height: 1;
    margin: 2 0 1 0;
}

#final-status,
#prep-status {
    height: 2;
    width: 100%;
    text-align: center;
}

/* ------------------------------------------------------------------ gate */

#gate-root {
    height: 100%;
    layout: vertical;
    align: center middle;
    padding: 2 4;
}

#gate-title {
    height: 3;
    width: 100%;
    text-align: center;
}

#gate-desc {
    height: 4;
    width: 100%;
    text-align: center;
}

#gate-buttons {
    height: 3;
    width: auto;
    align: center middle;
}

#gate-existing {
    height: auto;
    width: 100%;
    padding: 2 8;
}

#gate-list {
    width: 76;
    height: 8;
    margin-top: 1;
    border: round #30363d;
    background: #161b22;
}

#gate-list > .option-list--option-highlighted {
    background: #21545c;
    color: #ffffff;
    text-style: bold;
}

/* ------------------------------------------------------------------ form */

#form-root {
    height: 100%;
    padding: 2 6;
}

#form-title {
    height: 2;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: #c9d1d9;
}

#form-agents {
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 4;
    height: 5;
    margin: 1 0;
}

#form-path-status,
#form-detected,
#form-error {
    height: auto;
    margin-top: 1;
}

#form-buttons {
    height: 3;
    margin-top: 1;
}

/* ------------------------------------------------------------- dashboard */

#dash-root {
    height: 100%;
    layout: vertical;
}

#dash-header {
    height: 5;
    padding: 0 2;
    background: #161b22;
}

#dash-badge {
    width: 19;
    height: 4;
    margin: 1 2 0 1;
}

#dash-title {
    width: 1fr;
    height: 4;
    padding: 1 2 0 2;
}

#dash-run {
    width: 16;
    height: 3;
    margin: 1 1 0 1;
}

#dash-quit {
    width: 12;
    height: 3;
    margin: 1 1 0 1;
}

#dash-body {
    height: 1fr;
}

#dash-sidebar {
    width: 32;
    height: 100%;
    background: #0d1117;
    border: none;
    border-right: solid #30363d;
    padding: 1 0;
    scrollbar-size: 1 1;
}

#dash-sidebar > .option-list--option-highlighted {
    background: #1f2937;
    color: #f3e2b8;
    text-style: bold;
}

#dash-sidebar:focus > .option-list--option-highlighted {
    background: #21545c;
    color: #ffffff;
    text-style: bold;
}

#dash-sidebar > .option-list--option-disabled {
    color: #6e7681;
}

#dash-content {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    border: round #30363d;
    scrollbar-size: 1 1;
}

#dash-footer {
    height: 1;
    background: #161b22;
    padding: 0 1;
}

.panel-heading {
    height: auto;
    padding-bottom: 1;
}

.tiles {
    height: 7;
    padding-bottom: 1;
}

.gauge {
    height: 2;
}

.actions {
    height: 3;
    margin-top: 1;
}

.variant-box {
    height: 1;
    margin-left: 2;
}
